{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ahorraso",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permite a AhorRaso reconocer y transcribir tus gastos hablados.",
        "NSMicrophoneUsageDescription": "Permite a AhorRaso acceder a tu micrófono para registrar gastos por voz."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.jcode123.mobile",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permite a AhorRaso acceder a tu micrófono para registrar gastos por voz.",
          "speechRecognitionPermission": "Permite a AhorRaso reconocer y transcribir tus gastos hablados.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      "expo-local-authentication",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/withAndroidPrivacy",
      "./plugins/withShortNativeCmakePaths"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f21b54a9-c059-4cf6-a5f9-f9e723843d50"
      }
    },
    "owner": "jcode123"
  }
}
